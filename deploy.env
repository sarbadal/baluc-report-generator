# Flask
FLASK_SECRET_KEY=change-me

# Storage backend: local or gcs
STORAGE_BACKEND=gcs

# Required only when STORAGE_BACKEND=gcs
GCS_BUCKET_NAME=reports-baluc


# -----------------------------------------------------------------------------
# New app runtime variables (used by app/config.py)
# -----------------------------------------------------------------------------
# App environment: development|dev|production|prod|testing
APP_ENV=production
# Optional alias used by deployment script normalization.
ENV_TYPE=prod

# Flask secret key expected by current app config.
SECRET_KEY=change-me
# Optional app-level password. Leave blank to disable the password gate.
APP_PASSWORD=cng@me@baluc@2026

# Report storage config (current names used by create_app/config)
REPORT_STORAGE_BACKEND=gcs
REPORT_STORAGE_BUCKET_NAME=reports-baluc
REPORT_GCS_BUCKET_PREFIX=inventory-baluc
REPORT_STORAGE_METADATA_OBJECT=reports/report_history.json
REPORT_STORAGE_REPORTS_PREFIX=reports/generated
REPORT_HISTORY_LIMIT=100
REPORT_RETENTION_DAYS=30
REPORT_STATUS_POLL_SECONDS=5
# External Cloud Function URL used by Flask to trigger report processing.
REPORT_TRIGGER_FUNCTION_URL=https://process-in-bq-xakrcjmrua-uc.a.run.app
REPORT_TRIGGER_TIMEOUT_SECONDS=30
REPORT_TRIGGER_AUTH_TOKEN=
REPORT_TRIGGER_CA_BUNDLE_PATH=
REPORT_TRIGGER_INSECURE_SKIP_VERIFY=false
REPORT_TRIGGER_DISABLE_SYSTEM_PROXY=false

# Print/EV report transformation configuration
REPORT_PRINT_KEY_COLUMNS=pub_name,state,caption
REPORT_PRINT_DATE_COLUMN=finalschdt
# Keep blank to default to 0 when EV join is not available.
REPORT_PRINT_KPI_COLUMN=

# Preferred JSON mapping format (print column -> EV column)
# Example: {"pub_name":"POP Name","state":"State","caption":"Caption"}
REPORT_EV_JOIN_MAPPING_JSON={"pub_name":"pub_name","state":"state","caption":"caption"}
# Legacy format fallback: print_column:ev_column pairs separated by commas
REPORT_EV_JOIN_MAPPING=pub_name:pub_name,state:state,caption:caption
REPORT_EV_DATE_COLUMN=finalschdt
REPORT_EV_KPI_COLUMN=kpi
REPORT_WINDOW_BEFORE=2
REPORT_WINDOW_AFTER=2

# Static asset serving config
# In production, static URLs are served from this bucket/prefix.
STATIC_BUCKET=reports-static-baluc
STATIC_GCS_PREFIX=static
# Leave blank to auto-build as:
# https://storage.googleapis.com/${STATIC_BUCKET}/${STATIC_GCS_PREFIX}
STATIC_ASSET_BASE_URL=


# -----------------------------------------------------------------------------
# Deployment script variables (used by deployment.py)
# -----------------------------------------------------------------------------
DEPLOY_PROJECT_ID=balu-c
DEPLOY_REGION=us-central1
DEPLOY_FUNCTION_NAME=baluc-report-generator
DEPLOY_ENTRY_POINT=entry_point
DEPLOY_RUNTIME=python312
DEPLOY_BUCKET_NAME=reports-static-baluc
DEPLOY_BUCKET_LOCATION=US
DEPLOY_STATIC_DIR=app/static
DEPLOY_SOURCE_DIR=.
DEPLOY_STATIC_GCS_PREFIX=static
DEPLOY_STATIC_ASSET_BASE_URL=
DEPLOY_ALLOW_UNAUTHENTICATED=true

# Explicit GCP project variables for runtime GCS client resolution
GOOGLE_CLOUD_PROJECT=balu-c
PROJECT_ID=balu-c
